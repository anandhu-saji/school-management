# ====================================================================
# GHSS Student Portal - Server Environment Variables Configuration
# ====================================================================

# Port & Server Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Standalone local: mongodb://localhost:27017/ghss_student_portal
# Local ReplicaSet: mongodb://localhost:27017/ghss_student_portal?replicaSet=rs0
# MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ghss_student_portal?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/ghss_student_portal?replicaSet=rs0

# JWT Authentication
JWT_SECRET=super_secret_school_portal_key_2026
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (separated by commas or matching CLIENT_URL)
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 (Optional: for Google Single Sign-on)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# SMTP Nodemailer Email Service (For OTP & Email Notifications)
EMAIL_USER=your_school_email@gmail.com
EMAIL_PASS=your_email_app_password

# AWS S3 Bucket Configuration (Optional: for cloud file and KYC document uploads)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET_NAME=ghss-portal-documents

# Razorpay Online Payment Gateway Configuration
# Test keys format: rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_schoolportal2026
RAZORPAY_KEY_SECRET=secret_schoolportal_key_2026
